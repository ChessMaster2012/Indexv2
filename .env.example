# The app's AI runs in each user's browser with WebLLM and WebGPU.
# No API key, server secret, or AI provider credits are required for AI features.
# Most hosts set PORT automatically; Replit uses PORT=5000.
PORT=3000

# Optional — enables "Continue with Google" on the sign-in screen.
# Without these, the Google button just stays hidden; email/phone sign-in and
# guest nicknames still work with zero configuration.
#
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth Client ID -> Application type: Web application
# 3. Under "Authorized redirect URIs" add EXACTLY:
#      http://localhost:3000/api/auth/google/callback        (for local testing)
#      https://YOUR-DEPLOYED-DOMAIN/api/auth/google/callback  (for production —
#      use your actual deployed URL)
# 4. Copy the Client ID and Client Secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
